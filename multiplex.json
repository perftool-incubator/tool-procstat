{
    "presets": {
        "defaults" : [
            { "arg": "files", "vals": ["interrupts,vmstat,slabinfo,softirqs,meminfo,schedstat,net/softnet_stat"] },
            { "arg": "interval", "vals": ["3"] }
        ]
    },
    "validations": {
        "proc_file_list" : {
            "description" : "a comma-separated list of relative /proc file paths to snapshot (e.g. 'interrupts,vmstat,net/softnet_stat')",
            "args" : [ "files" ],
            "vals": "^[A-Za-z0-9_./-]+(,[A-Za-z0-9_./-]+)*$"
        },
        "positive_integer" : {
            "description" : "a whole number greater than 0",
            "args" : [ "interval" ],
            "vals": "^[1-9][0-9]*$"
        }
    }
}
